{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sensor Layout Studio",
  "version": "0.1.0",
  "identifier": "io.sensorlayout.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sensor Layout Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; worker-src 'self' blob:",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Camera and LiDAR placement in 3D",
    "copyright": "Copyright © 2026 Sensor Layout Studio contributors",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_RUST_NOTICES.md": "licenses/THIRD_PARTY_RUST_NOTICES.md",
      "../docs/cad-runtime.md": "licenses/cad-runtime.md",
      "../docs/licenses/sources.json": "licenses/upstream-license-sources.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": { "displayLanguageSelector": false, "languages": ["English", "Japanese"] }
    }
  }
}
